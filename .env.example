# Copy this file to .env and adjust as needed. .env is git-ignored, so your
# keys never get committed.

# Which provider/model every module's get_chat_model() builds.
# Default is a local, free, no-key Ollama model -- leave these two unset (or
# matching the values below) to use it.
MODEL_PROVIDER=ollama
MODEL_NAME=qwen2.5:7b

# --- Examples for other providers (uncomment the two lines you want) ---
#
# OpenAI:
# MODEL_PROVIDER=openai
# MODEL_NAME=gpt-4o-mini
# OPENAI_API_KEY=sk-...
#
# Anthropic (Claude):
# MODEL_PROVIDER=anthropic
# MODEL_NAME=claude-sonnet-5-5
# ANTHROPIC_API_KEY=sk-ant-...
#
# Google (Gemini):
# MODEL_PROVIDER=google_genai
# MODEL_NAME=gemini-2.5-flash
# GOOGLE_API_KEY=...
#
# Groq:
# MODEL_PROVIDER=groq
# MODEL_NAME=llama-3.3-70b-versatile
# GROQ_API_KEY=gsk_...
#
# Each provider above also needs its langchain integration package
# installed -- see requirements.txt / README.md.
